	"eagle_eyed_enchantment": true,
	// Disable when LevelZ mod installed
	"inaccuracy_curse_enchantment": false,
	// client only
	"polar_star": true,
	// Only visible through spy glass, client only
	"other_stars": true,
	"custom_item_name_non_despawn": true,
	"totem_of_non_breaking": true,
	// 0.1 = 10% chance
	"evoker_use_totem_chance": 0.25,
	"not_look_at_invisible": true,
	"chainmail_spike_protection": true,
	"charged_creeper_spawn_chance": 0.005,
	"creeper_on_fire": true,
	"fast_oxidization": true,
	"spectral_arrow_light": true,
	"iron_golem_repair_friendly": true,
	"skeleton_bow_damaged": true,
	"break_skeleton_bow_chance": 0.005,
	"path_block_speed_boost": 0.03,
	// Ticks: 20 = 1 second
	"disable_elytra_on_damage_time": 40,
	"disable_elytra_underwater": true,
	"husk_drops_sand": true,
	"trident_buried_treasure": false,
	// client only
	"villager_sleeping_eyes": true,
	"villager_gender": true,
	// No trading when villager has no space
	"villager_needs_space": true,
	// 0 = disabled
	"max_iron_golem_villager_spawn": 3,
	"path_block_under_gates": true,
	"shovel_undo_farmland": true,
	// If top is banner, player has to wear shield with same pattern
	"beacon_shield_pattern": true,
	// 0 = disabled
	"max_spawner_count": 30,
	// 0 = disabled
	"spawner_tick_deactivation": 6000,
	// 90 = 3 bubbles
	"botte_air_amount": 90,
	"flame_arrow_burn": true,
	// Set entity on fire
	"magma_cube_fire_ticks": 20,
	// 20 ticks = 1 second
	"shield_blocking_cooldown": 60,
	// Heal passive entity 2hp every ticks
	"heal_passive_entity_over_time_ticks": 1200,
	// Change slot highlight to texture, client only
	"change_slot_highlight": false,
	"fletching_table_use": true,
	// client only
	"show_component_tooltip": false,
	// Repair trident with prismarine shards
	"repair_trident": true,
	// client only
	"show_jukebox_disc": true,
	"snow_under_trees": true,
	"spawn_not_on_leaves": true,
	// Minimum time in ticks during rain + nextInt(this)
	"campfire_rain_extinguish": 160,
	// Only in cold biomes
	"strays_affected_by_daylight": false,
	"start_riding_fall_damage": true,
	"boat_fall_damage_nerf": true,
	"teleport_potion": true,
	"teleport_scroll": true,
	"chunk_loader": true,
	// Value per item, 20 ticks = 1 second
	"chunk_loader_fuel_time": 144000,
	"sneak_through_berries": true,
	"phantom_tick_time": 72000,
	"ladder_climb_speeding": false,
	// client only
	"trinket_slot_arrangement": false,
	"remove_vanilla_villager_trades": false,
	// Vanilla = 5 trades
	"wandering_trader_trade_count": 5,
	// Mobs like animals get spawned with a higher chance in a group
	"passive_entity_group_spawn": false,
	// Exclude entities e.g.: minecraft:villager
	"passive_entity_group_spawn_exclude": [
